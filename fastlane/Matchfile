# Point match at the org's shared Match-Secrets repo. Same pattern as Trio
# — the GITHUB_REPOSITORY_OWNER env var is set by GitHub Actions to the
# org or user that owns the repo, so this works for forks too.
GITHUB_REPOSITORY_OWNER ||= ENV["GITHUB_REPOSITORY_OWNER"]

git_url("https://github.com/#{GITHUB_REPOSITORY_OWNER}/Match-Secrets.git")
storage_mode("git")
type("appstore")
