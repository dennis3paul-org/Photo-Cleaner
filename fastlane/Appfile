# Set these in GitHub Secrets and via env vars locally — Fastfile reads them.
# The Appfile is committed; only non-sensitive defaults belong here.

app_identifier("com.dennispaul.PhotoCleaner")

# apple_id is read from env var APPLE_ID — needed locally for `fastlane pilot`
# from your Mac. Not used by the CI lane (CI uses App Store Connect API key).
apple_id(ENV["APPLE_ID"]) if ENV["APPLE_ID"]

# Your Team ID. Set this via env var DEVELOPER_TEAM_ID — both locally and as
# a GitHub Secret — so the same Fastfile works in CI and dev. You can find
# this in App Store Connect → Membership.
team_id(ENV["DEVELOPER_TEAM_ID"]) if ENV["DEVELOPER_TEAM_ID"]

itc_team_id(ENV["DEVELOPER_TEAM_ID"]) if ENV["DEVELOPER_TEAM_ID"]
